# Nourax Workspace - non-secret settings.
# Copy to .env on the server (scripts/setup.sh does this) and fill in the values.
# Secrets are NOT kept here. They live as files in SECRETS_DIR (see docs/operations.md).

# Public hostnames (Cloudflare Tunnel routes point here)
DRIVE_HOST=drive.example.org
OFFICE_HOST=office.example.org

# Cloudflare account that owns the R2 buckets
CF_ACCOUNT_ID=00000000000000000000000000000000

# R2 bucket that holds all file contents (Nextcloud primary object storage)
R2_BUCKET=nourax-drive
# R2 bucket for nightly database/config backups and the weekly file mirror
R2_BACKUP_BUCKET=nourax-workspace-backups

# "Log in with Nourax": NoMail's Supabase Auth acts as the OpenID Connect provider
SUPABASE_AUTH_URL=https://your-project-ref.supabase.co/auth/v1

# Where the secret files live on the server (root-only directory)
SECRETS_DIR=/etc/nourax/secrets

# Extra ONLYOFFICE editor plugins (the AI plugin), filled by scripts/onlyoffice-plugins.sh
ONLYOFFICE_PLUGINS_DIR=/opt/nourax/onlyoffice-plugins

# Pinned image versions. Upgrade Nextcloud one major version at a time (scripts/update.sh).
NEXTCLOUD_IMAGE=nextcloud:35.0.2-apache
POSTGRES_IMAGE=postgres:18-alpine
REDIS_IMAGE=redis:8.8-alpine
ONLYOFFICE_IMAGE=onlyoffice/documentserver:10.0.0
CLOUDFLARED_IMAGE=cloudflare/cloudflared:2026.10.2

# Language and region defaults for new accounts
DEFAULT_LANGUAGE=en_GB
DEFAULT_LOCALE=en_GB
DEFAULT_PHONE_REGION=GB
DEFAULT_TIMEZONE=Europe/London

# Virus scanner (compose service "clamav"). The image has a default in compose.yaml too.
CLAMAV_IMAGE=clamav/clamav:1.5.4_base
# Memory limit for ClamAV (signatures in memory, about 1.2 GB). 1600m on today's 3.7 GB server;
# docs/search-and-antivirus.md has the value for 8 GB.
CLAMAV_MEM_LIMIT=1600m

# NoMail, opened from the app menu (the nourax_branding app). Optional: without it the link goes to
# https://mail.nourax.org/.
#NOMAIL_URL=https://mail.example.org/

# Search inside files (compose service "elasticsearch"). The image has a default in compose.yaml too.
ELASTICSEARCH_IMAGE=elasticsearch:9.5.5
# Java heap of Elasticsearch and the container's memory limit (heap plus about 400 MB outside it).
# 512m and 1g on today's 3.7 GB server; docs/search-and-antivirus.md has the values for 8 GB.
ES_JAVA_HEAP=512m
ES_MEM_LIMIT=1g
# Memory limit of the service "jobs" (the search index of new files, every 2 minutes). Between runs
# it holds a few MB; a run needs about 100 MB, more for big documents. 384m on today's server;
# 512m on 8 GB, where files up to 25 MB are read (SEARCH_MAX_FILE_MB below).
JOBS_MEM_LIMIT=384m

# Nourax AI for the Assistant (docs/assistant.md): the relay to NIG (compose service "ai-relay") and
# the worker that runs AI tasks at once (service "ai-worker"). The image has a default in compose.yaml too.
AI_RELAY_IMAGE=python:3.13.16-alpine3.24
# NIG's address; the default is https://nig.nourax.org
#NIG_URL=https://nig.nourax.org
# off: NIG gets whole-answer requests (each one carries its token count, so it is charged); on once NIG
# confirms that streamed calls are charged too. Then: docker compose up -d ai-relay
AI_RELAY_STREAM=off
# The model the Assistant uses for every text task: nourax-smart, nourax-long-context or nourax-fast.
NOURAX_AI_MODEL=nourax-smart
# Memory limits: the relay holds about 20 MB, the worker one PHP process (about 60 MB while idle).
AI_RELAY_MEM_LIMIT=64m
AI_WORKER_MEM_LIMIT=320m

# How often a day ClamAV looks for new signatures (compose service "clamav"; 2 if not set). Each new
# set is loaded in place, and scans wait about 45 seconds meanwhile, so keep 2 on today's server.
FRESHCLAM_CHECKS=2
# Search inside files reads the words of files up to this size, in MB; bigger files are found by
# name only (scripts/configure.d/50-search.sh; 20 if not set).
SEARCH_MAX_FILE_MB=20

# After the upgrade to an 8 GB server, change the sizes above to these (with the owner's yes; the
# steps, the undo and the tests: docs/search-and-antivirus.md, "After the upgrade to 8 GB"):
#   CLAMAV_MEM_LIMIT=3g     plus, in config/clamav/, ConcurrentDatabaseReload yes and TestDatabases yes
#   ES_JAVA_HEAP=1g
#   ES_MEM_LIMIT=2g
#   JOBS_MEM_LIMIT=512m
#   SEARCH_MAX_FILE_MB=25
#   FRESHCLAM_CHECKS=4      (optional: new signatures every 6 hours)
#   AI_RELAY_MEM_LIMIT=64m and AI_WORKER_MEM_LIMIT=320m stay as they are.
