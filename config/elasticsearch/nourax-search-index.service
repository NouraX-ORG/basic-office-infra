# Indexes the files waiting for search inside files (new, changed, shared or moved ones). Installed
# and started by scripts/configure.d/50-search.sh; why: docs/search-and-antivirus.md.
# SPDX-License-Identifier: AGPL-3.0-or-later
[Unit]
Description=Nourax Workspace search index of new and changed files
Wants=docker.service
After=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/nourax/basic-office-infra
ExecStart=/bin/bash /opt/nourax/basic-office-infra/config/elasticsearch/index-queue.sh
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=1h
