{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nodrive-upload",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-20",
  // No workers.dev URL and no preview URLs: the Worker runs only on its route.
  "workers_dev": false,
  "preview_urls": false,
  // The route, switched on 2026-10-28 with the owner's yes (docs/nomail-contract.md, "Upload Worker").
  // Only this path on the Drive hostname runs the Worker; everything else goes straight to Nextcloud.
  // A deploy replaces the script's routes with this list, so keep the line.
  "routes": [{ "pattern": "drive.nourax.org/nomail-upload/*", "zone_name": "nourax.org" }],
  "observability": { "enabled": true },
  "vars": {
    "ORIGIN_BASE": "https://drive.nourax.org",
    "ALLOWED_ORIGINS": "https://mail.nourax.org",
    "MAX_CHUNK_BYTES": "52428800",
    "MAX_UPLOAD_BYTES": "10737418240"
  }
  // Secret (set with `wrangler secret put`, never committed):
  //   UPLOAD_TICKET_KEY   32 random bytes, base64url. NoMail holds the same value as DRIVE_UPLOAD_TICKET_KEY.
  //                       The server keeps it as /etc/nourax/secrets/upload_ticket_key.
}
