<?xml version="1.0"?>
<!--
  - SPDX-License-Identifier: AGPL-3.0-or-later
  -
  - Nourax Workspace branding. The app id and namespace leave out the upstream name on purpose
  - (docs/branding.md). Event listeners and occ commands need no version bump. The background job
  - below is also added by occ nourax_branding:sweep itself, so it needed no version bump either; a
  - new database table would, followed by `occ upgrade`.
-->
<info>
	<id>nourax_branding</id>
	<name>Nourax Branding</name>
	<summary>The Nourax Workspace look and wording, and NoMail in the app menu</summary>
	<description>Adds NoMail to the app menu of every signed-in person; it opens Nourax mail in a new tab. Its text sweep rewrites the upstream name in the translations of every enabled app, in every language, and runs again by itself when apps change.</description>
	<version>1.0.0</version>
	<licence>agpl</licence>
	<author>Nourax</author>
	<namespace>NouraxBranding</namespace>
	<category>customization</category>
	<dependencies>
		<php min-version="8.3"/>
		<nextcloud min-version="35" max-version="35"/>
	</dependencies>
	<background-jobs>
		<job>OCA\NouraxBranding\BackgroundJob\RefreshSweep</job>
	</background-jobs>
	<commands>
		<command>OCA\NouraxBranding\Command\Sweep</command>
	</commands>
</info>
