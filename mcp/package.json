{
  "name": "nourax-workspace-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dev": "wrangler dev --env dev --ip 127.0.0.1 --port 8787",
    "deploy": "node scripts/predeploy.mjs --deploy",
    "test": "vitest run && node scripts/predeploy.mjs --bundle-only",
    "test:unit": "vitest run",
    "test:live": "vitest run --config vitest.live.config.ts",
    "check:bundle": "node scripts/predeploy.mjs --bundle-only",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test && tsc --noEmit -p test/live",
    "types": "wrangler types --env-interface Env --strict-vars=false",
    "tool-docs": "node scripts/gen-tool-docs.mjs"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "1.2.4",
    "@modelcontextprotocol/server": "2.3.1",
    "fflate": "0.8.3",
    "ical.js": "2.2.1",
    "jose": "6.2.12",
    "saxes": "6.0.0",
    "timezones-ical-library": "2.3.2",
    "unpdf": "1.8.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.7",
    "@modelcontextprotocol/client": "2.3.1",
    "fast-check": "4.10.2",
    "typescript": "6.0.3",
    "vitest": "5.0.5",
    "wrangler": "4.152.0"
  }
}
